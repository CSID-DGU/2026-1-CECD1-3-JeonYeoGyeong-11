{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fedcommerce.local/schemas/commerce_order.v1.schema.json",
  "title": "commerce_order.v1",
  "description": "판매자 주문 API/DB가 소유하는 운영 기록. 판매자 로컬에만 저장한다. 기준: CONTRACTS.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "seller_id",
    "order_id",
    "customer_id_local",
    "idempotency_key",
    "status",
    "status_version",
    "created_at",
    "completed_at",
    "cancelled_at",
    "currency",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "commerce_order.v1"
    },
    "seller_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "CONTRACTS.md R6"
    },
    "order_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "CONTRACTS.md R6. seller_id 범위에서 유일"
    },
    "customer_id_local": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "CONTRACTS.md R6, §3.4"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "CONTRACTS.md"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "accepted",
        "completed",
        "cancelled"
      ],
      "default": "requested",
      "description": "CONTRACTS.md"
    },
    "status_version": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "CONTRACTS.md S2. 판매자 주문 API만 올린다"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "description": "주문 생성 시각. CONTRACTS.md R9"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "description": "status=completed일 때만 non-null. CONTRACTS.md",
      "default": null
    },
    "cancelled_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "description": "status=cancelled일 때만 non-null. CONTRACTS.md",
      "default": null
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 대문자 3글자"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "description": "순서는 무의미하다. CONTRACTS.md",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id_local",
          "quantity",
          "unit_price_minor"
        ],
        "properties": {
          "item_id_local": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "description": "CONTRACTS.md R6"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price_minor": {
            "type": "integer",
            "minimum": 0,
            "description": "통화 최소 단위 정수. 부동소수 금지"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "completed_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "cancelled"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "cancelled_at": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "cancelled_at": {
            "type": "null"
          }
        }
      }
    }
  ]
}
