{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fedcommerce.local/schemas/shared_model_manifest.v1.schema.json",
  "title": "shared_model_manifest.v1",
  "description": "B가 생성하는 라운드 무관 모델 기술서. 기준: MODEL_BOUNDARY.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "architecture_version",
    "task_kind",
    "preprocessing_version",
    "text_artifact_hash",
    "tensors",
    "manifest_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "shared_model_manifest.v1"
    },
    "architecture_version": {
      "type": "integer",
      "minimum": 1,
      "description": "MODEL_BOUNDARY.md 표와 §3 식이 바뀌면 올린다"
    },
    "task_kind": {
      "const": "next_purchase",
      "description": "D0003"
    },
    "preprocessing_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "text_artifact_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "가중치·tokenizer·config 파일별 해시와 인코더 실행 설정의 정규 JSON SHA-256. MODEL_BOUNDARY.md."
    },
    "tensors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "shape",
          "dtype"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^shared\\.[A-Za-z0-9_]+$",
            "description": "§3의 shared 함수 9그룹에 속한 텐서만. 실제 키 목록은 manifest가 정본"
          },
          "shape": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "description": "JSON 정수 배열. 튜플 문자열 금지"
          },
          "dtype": {
            "type": "string",
            "enum": [
              "float32",
              "float16",
              "int64"
            ],
            "description": "numpy 소문자 이름만. 프레임워크 접두사 금지"
          }
        }
      }
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "자신을 제외한 정규 JSON의 sha256 hex"
    }
  }
}
