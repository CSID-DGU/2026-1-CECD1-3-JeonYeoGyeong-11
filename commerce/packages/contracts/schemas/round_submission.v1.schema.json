{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fedcommerce.local/schemas/round_submission.v1.schema.json",
  "title": "round_submission.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transport_mode",
    "delta_manifest",
    "aggregate_metrics",
    "payload_sha256",
    "payload_nbytes"
  ],
  "properties": {
    "schema_version": {
      "const": "round_submission.v1"
    },
    "transport_mode": {
      "const": "synthetic_plaintext"
    },
    "delta_manifest": {
      "$ref": "#/$defs/delta_manifest"
    },
    "aggregate_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loss_mean",
        "grad_norm_mean"
      ],
      "properties": {
        "loss_mean": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "grad_norm_mean": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload_nbytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8388608
    }
  },
  "$defs": {
    "delta_manifest": {
      "title": "delta_manifest.v1",
      "description": "B → C shared_delta 동봉 manifest. 기준: MODEL_BOUNDARY.md.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "seller_id",
        "round_id",
        "model_version",
        "manifest_hash",
        "architecture_version",
        "completed",
        "tensors"
      ],
      "properties": {
        "schema_version": {
          "const": "delta_manifest.v1"
        },
        "seller_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "description": "CONTRACTS.md R6"
        },
        "round_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "manifest_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "architecture_version": {
          "type": "integer",
          "minimum": 1
        },
        "completed": {
          "type": "boolean"
        },
        "tensors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "shape",
              "dtype"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^shared\\.[A-Za-z0-9_]+$"
              },
              "shape": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "dtype": {
                "const": "float32",
                "description": "MODEL_BOUNDARY.md. delta의 dtype은 float32로 고정한다"
              }
            }
          }
        }
      }
    }
  }
}
