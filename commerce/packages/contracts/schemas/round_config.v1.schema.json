{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fedcommerce.local/schemas/round_config.v1.schema.json",
  "title": "round_config.v1",
  "description": "C가 생성하는 라운드 설정. 기준: MODEL_BOUNDARY.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "round_id",
    "model_version",
    "manifest_hash",
    "architecture_version",
    "min_clients",
    "deadline",
    "local_steps",
    "max_local_epochs",
    "n_neg",
    "batch_size",
    "learning_rate",
    "seed"
  ],
  "properties": {
    "schema_version": {
      "const": "round_config.v1"
    },
    "round_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "C가 부여"
    },
    "model_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "라운드 시작 기준 모델 버전. 집계 성공 후 새 버전을 발급한다."
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "이 라운드가 요구하는 manifest"
    },
    "architecture_version": {
      "type": "integer",
      "minimum": 1,
      "description": "manifest와 일치해야 한다"
    },
    "min_clients": {
      "type": "integer",
      "minimum": 1,
      "description": "최소 참여 수. 합성 데모 3 이상, 보호 모드 5 이상 및 선택 프로토콜 조건. 숫자 자체는 보호 수단이 아니다."
    },
    "deadline": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "description": "CONTRACTS.md R9 (RFC 3339, UTC 'Z')"
    },
    "local_steps": {
      "type": "integer",
      "minimum": 0,
      "description": "A-0은 0(MODEL_BOUNDARY.md)"
    },
    "max_local_epochs": {
      "type": "integer",
      "minimum": 0,
      "description": "로컬 데이터 통과 횟수 상한. 기본값 6, 0은 상한 없음. 실제 수행 스텝 tau_i = min(local_steps, ceil(n_i / batch_size) * max_local_epochs) (MODEL_BOUNDARY.md)"
    },
    "n_neg": {
      "type": "integer",
      "minimum": 1,
      "description": "MODEL_BOUNDARY.md의 N_neg"
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1,
      "description": "전 판매자 공통"
    },
    "learning_rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "전 판매자 공통"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "description": "전 판매자 공통"
    }
  }
}
