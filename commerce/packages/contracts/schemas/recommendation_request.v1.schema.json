{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fedcommerce.local/schemas/recommendation_request.v1.schema.json",
  "title": "recommendation_request.v1",
  "description": "A → B 추천 요청. 기준: CONTRACTS.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "seller_id",
    "customer_id_local",
    "as_of",
    "candidate_item_ids",
    "top_n"
  ],
  "properties": {
    "schema_version": {
      "const": "recommendation_request.v1"
    },
    "seller_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "CONTRACTS.md R6"
    },
    "customer_id_local": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "고객 참조. 원문 이력을 보내지 않는다"
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "description": "CONTRACTS.md A1~A4. 생략·null 금지"
    },
    "candidate_item_ids": {
      "type": [
        "array",
        "null"
      ],
      "uniqueItems": true,
      "maxItems": 50000,
      "default": null,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
        "description": "CONTRACTS.md R6"
      },
      "description": "null이면 B가 listing_status=active 전체를 후보로 삼는다(§7.3)"
    },
    "top_n": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 1000,
      "default": null
    }
  }
}
