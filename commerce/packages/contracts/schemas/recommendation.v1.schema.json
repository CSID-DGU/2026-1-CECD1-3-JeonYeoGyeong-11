{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fedcommerce.local/schemas/recommendation.v1.schema.json",
  "title": "recommendation.v1",
  "description": "B → A 추천 응답. 기준: CONTRACTS.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "seller_id",
    "customer_id_local",
    "as_of",
    "model_version",
    "score_semantics",
    "horizon_days",
    "is_cold_start",
    "fallback_reason",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "recommendation.v1"
    },
    "seller_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "요청값과 같아야 한다"
    },
    "customer_id_local": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "요청값과 같아야 한다"
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "description": "요청값 반향. CONTRACTS.md A4"
    },
    "model_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "score_semantics": {
      "type": "string",
      "enum": [
        "next_purchase",
        "within_horizon"
      ],
      "description": "이번 학기는 next_purchase만 사용한다(D0003)"
    },
    "horizon_days": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "default": null,
      "description": "CONTRACTS.md"
    },
    "is_cold_start": {
      "type": "boolean",
      "default": false
    },
    "fallback_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "no_customer_history",
        "no_seller_history",
        "no_shared_model",
        null
      ],
      "default": null
    },
    "items": {
      "type": "array",
      "minItems": 0,
      "description": "score 내림차순, 동률은 item_id_local 사전순(SC3). 후보 0건이면 빈 배열(SC6)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id_local",
          "score"
        ],
        "properties": {
          "item_id_local": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "description": "CONTRACTS.md R6"
          },
          "score": {
            "type": "number",
            "description": "유한 실수이며 확률이 아니다(SC1). JSON은 NaN·Infinity 리터럴을 허용하지 않는다"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "score_semantics": {
            "const": "next_purchase"
          }
        },
        "required": [
          "score_semantics"
        ]
      },
      "then": {
        "properties": {
          "horizon_days": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "horizon_days": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "is_cold_start": {
            "const": true
          }
        },
        "required": [
          "is_cold_start"
        ]
      },
      "then": {
        "properties": {
          "fallback_reason": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "fallback_reason": {
            "type": "null"
          }
        }
      }
    }
  ]
}
